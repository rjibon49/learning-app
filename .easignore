
# Node.js
node_modules/
**/node_modules/

# Build files
.next/
dist/
build/
out/
.expo/
.turbo/
coverage/

# Environment secrets
.env
.env.*
!.env.example
!.env.*.example

# Sensitive credentials
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
google-services.json
GoogleService-Info.plist

# Database backups
*.sql
*.sql.gz
*.dump
backups/

# Logs and temporary files
*.log
logs/
tmp/
temp/

# System files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/*
!.vscode/extensions.json

# ------------------------------------------------------------------
# EAS Build upload (.easignore replaces .gitignore for EAS uploads)
# Only the mobile app is built on EAS. The other workspaces keep just
# their package.json so `npm ci` with the root lockfile still works.
# ------------------------------------------------------------------
apps/admin/*
!apps/admin/package.json
apps/api/*
!apps/api/package.json
apps/website/*
!apps/website/package.json
workers/*/*
!workers/*/package.json
content/
docs/
infrastructure/
tools/
.github/
