# Copy to .env and fill in real values. NEVER commit .env.
# Generate secrets with:  openssl rand -hex 32

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001
HTTP_BODY_LIMIT=1mb

# Behind Traefik/Nginx on the VPS. Default trusts Docker/private-network proxies.
# TRUST_PROXY=loopback, linklocal, uniquelocal

DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/learning_app

# Admin auth (must be different from LEARNER_JWT_SECRET)
ADMIN_JWT_SECRET=CHANGE_ME_64_HEX_CHARS
ADMIN_JWT_ISSUER=learning-api
ADMIN_JWT_AUDIENCE=learning-admin
ADMIN_ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_REFRESH_TOKEN_DAYS=7

# Learner auth
LEARNER_JWT_SECRET=CHANGE_ME_64_HEX_CHARS
REGISTRATION_OTP_SECRET=CHANGE_ME_64_HEX_CHARS

# Only used by `npm run seed:admin`
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_SEED_NAME=Platform Admin

# Cloudflare R2 (private bucket)
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=learning-app-media
R2_PUBLIC_URL=https://YOUR-PUBLIC-BUCKET-URL.r2.dev

# SMTP
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=465
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM="Learning Platform <no-reply@yourdomain.com>"

MEDIA_API_BASE_URL=http://127.0.0.1:4000/api

# Production requires a malware scanner binary (e.g. clamdscan)
MEDIA_SCANNER_BINARY=

WEB_AD_EVENT_SECRET=CHANGE_ME_64_HEX_CHARS

NOTIFICATION_QUEUE_WORKER_ENABLED=false
NOTIFICATION_DELIVERY_WORKER_ENABLED=false
NOTIFICATION_WORKER_PROCESS=false
NOTIFY_EMAIL_SEND_ENABLED=false
