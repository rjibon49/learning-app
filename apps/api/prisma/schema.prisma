generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// =============================================
// ENUMS
// =============================================

enum WritingDirection {
  LTR
  RTL
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
  CONTENT_EDITOR
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  CONTENT_EDITOR
}

enum PublicationStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum ResourceType {
  PDF
  AUDIO
  IMAGE
  VIDEO
  DOCUMENT
}

enum MediaType {
  IMAGE
  AUDIO
  PDF
  VIDEO
  DOCUMENT
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum MediaProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum QuestionType {
  MULTIPLE_CHOICE
  IMAGE_TO_TARGET
  TEXT_TO_TARGET
  AUDIO_TO_TARGET
  TARGET_TO_TRANSLATION
  TRANSLATION_TO_TARGET
  MATCHING
  FILL_BLANK
  ARTICLE
  LISTEN_AND_TYPE
  SPEAKING
  ORDERING
  TRUE_FALSE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ContentFormat {
  TEXT
  MARKDOWN
  HTML
  JSON
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
  REFUNDED
}

enum SubscriptionPlatform {
  GOOGLE_PLAY
  APPLE_APP_STORE
  WEB
  STRIPE
  MANUAL
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
  REFUNDED
  CANCELLED
}

enum AdProvider {
  ADMOB
  OTHER
}

enum JobType {
  GENERATE_AUDIO
  GENERATE_TRANSLATION
  GENERATE_EXAMPLE
  GENERATE_QUIZ
  PROCESS_PDF
  PROCESS_IMAGE
  PROCESS_DOCUMENT
  BULK_IMPORT
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

enum MasteryLevel {
  NEW
  LEARNING
  REVIEW
  MASTERED
}

// =============================================
// GLOBAL LANGUAGES & PROFICIENCY
// =============================================

model Language {
  id         String           @id @default(cuid())
  code       String           @unique @db.VarChar(16)
  name       String           @db.VarChar(100)
  nativeName String           @db.VarChar(100)
  direction  WritingDirection @default(LTR)
  isActive   Boolean          @default(true)
  sortOrder  Int              @default(0)
  metadata   Json?

  availableLevels LanguageProficiencyLevel[]
  apps            App[]
  courses         Course[]
  vocabularies    Vocabulary[]
  translations    VocabularyTranslation[]
  examples        VocabularyExample[]
  categoryNames   VocabularyCategoryTranslation[]
  lessonContents  LessonTranslation[]
  enrollments     UserLanguageEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model ProficiencyFramework {
  id          String  @id @default(cuid())
  code        String  @unique @db.VarChar(32)
  name        String  @db.VarChar(120)
  description String? @db.Text
  isActive    Boolean @default(true)

  levels ProficiencyLevel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProficiencyLevel {
  id          String  @id @default(cuid())
  frameworkId String
  code        String  @db.VarChar(32)
  name        String  @db.VarChar(120)
  description String? @db.Text
  sortOrder   Int     @default(0)

  framework ProficiencyFramework @relation(fields: [frameworkId], references: [id], onDelete: Restrict)

  languages   LanguageProficiencyLevel[]
  apps        App[]
  courses     Course[]
  enrollments UserLanguageEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([frameworkId, code])
  @@index([frameworkId, sortOrder])
}

model LanguageProficiencyLevel {
  id         String  @id @default(cuid())
  languageId String
  levelId    String
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)

  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  level ProficiencyLevel @relation(fields: [levelId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([languageId, levelId])
  @@index([languageId, isActive, sortOrder])
}

// =============================================
// APPLICATIONS
// =============================================

model App {
  id         String  @id @default(cuid())
  languageId String
  levelId    String?

  name        String
  slug        String  @unique
  packageName String? @unique
  bundleId    String? @unique

  description    String? @db.Text
  iconUrl        String? @db.Text
  primaryColor   String?
  secondaryColor String?
  isActive       Boolean @default(true)

  language Language @relation(fields: [languageId], references: [id], onDelete: Restrict)

  level ProficiencyLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)

  config         AppConfig?
  courseLinks    CourseApp[]
  quizzes        Quiz[]
  mediaAssets    MediaAsset[]
  subscriptions  Subscription[]
  adConfigs      AdConfig[]
  flashcardDecks FlashcardDeck[]
  importJobs     BulkImportJob[]
  jobs           BackgroundJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([languageId, levelId])
  @@index([isActive])
}

model AppConfig {
  id    String @id @default(cuid())
  appId String @unique

  adsEnabled           Boolean @default(true)
  subscriptionsEnabled Boolean @default(true)
  guestModeEnabled     Boolean @default(true)
  loginRequired        Boolean @default(false)

  defaultLanguage    String @default("en")
  supportedLanguages Json?
  settings           Json?

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================
// COURSES & LESSONS
// =============================================

model Course {
  id         String  @id @default(cuid())
  languageId String
  levelId    String?

  title       String
  slug        String
  description String? @db.Text

  status    PublicationStatus @default(DRAFT)
  sortOrder Int               @default(0)

  language Language @relation(fields: [languageId], references: [id], onDelete: Restrict)

  level ProficiencyLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)

  apps    CourseApp[]
  modules CourseModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([languageId, slug])
  @@index([languageId, levelId, status])
}

model CourseApp {
  id        String @id @default(cuid())
  courseId  String
  appId     String
  sortOrder Int    @default(0)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([courseId, appId])
  @@index([appId, sortOrder])
}

model CourseModule {
  id       String @id @default(cuid())
  courseId String

  title       String
  slug        String
  description String? @db.Text

  sortOrder Int               @default(0)
  status    PublicationStatus @default(DRAFT)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, slug])
  @@index([courseId, sortOrder])
}

model Lesson {
  id       String @id @default(cuid())
  moduleId String

  title String
  slug  String

  sortOrder        Int               @default(0)
  status           PublicationStatus @default(DRAFT)
  estimatedMinutes Int?

  module CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  translations LessonTranslation[]
  resources    LessonResource[]
  vocabularies Vocabulary[]
  quizzes      Quiz[]
  progress     LessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, slug])
  @@index([moduleId, sortOrder])
  @@index([status])
}

model LessonTranslation {
  id         String @id @default(cuid())
  lessonId   String
  languageId String

  title   String?
  content String        @db.LongText
  format  ContentFormat @default(MARKDOWN)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  language Language @relation(fields: [languageId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, languageId])
}

model LessonResource {
  id       String  @id @default(cuid())
  lessonId String
  assetId  String?

  type  ResourceType
  title String
  url   String?      @db.Text

  mimeType  String?
  fileSize  BigInt?
  pageCount Int?
  sortOrder Int     @default(0)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  asset MediaAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId, type])
  @@index([assetId])
}

// =============================================
// MEDIA STORAGE & PROCESSING
// =============================================

model MediaAsset {
  id    String  @id @default(cuid())
  appId String?

  type       MediaType
  visibility MediaVisibility       @default(PRIVATE)
  status     MediaProcessingStatus @default(PENDING)

  storageProvider String  @default("R2")
  bucket          String?
  objectKey       String  @unique
  publicUrl       String? @db.Text

  originalName     String?
  originalMimeType String?
  mimeType         String?
  fileSize         BigInt?
  originalSize     BigInt?

  width     Int?
  height    Int?
  duration  Int?
  pageCount Int?

  checksumSha256 String? @db.VarChar(64)
  altText        String? @db.Text

  optimizedFormat String?
  processingError String? @db.Text
  metadata        Json?

  app App? @relation(fields: [appId], references: [id], onDelete: SetNull)

  vocabularyImages   Vocabulary[]     @relation("VocabularyImage")
  vocabularyAudios   Vocabulary[]     @relation("VocabularyAudio")
  lessonResources    LessonResource[]
  announcementImages Announcement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appId, type])
  @@index([visibility, status])
}

// =============================================
// VOCABULARY & TRANSLATIONS
// =============================================

model VocabularyCategory {
  id String @id @default(cuid())

  name        String
  slug        String  @unique
  description String? @db.Text

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  translations VocabularyCategoryTranslation[]
  vocabulary   Vocabulary[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VocabularyCategoryTranslation {
  id         String @id @default(cuid())
  categoryId String
  languageId String

  name        String
  description String? @db.Text

  category VocabularyCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  language Language @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@unique([categoryId, languageId])
}

model Vocabulary {
  id         String  @id @default(cuid())
  languageId String
  lessonId   String?
  categoryId String?

  term          String  @db.VarChar(500)
  pronunciation String? @db.VarChar(500)
  partOfSpeech  String? @db.VarChar(80)

  // Gender, plural, declension, conjugation,
  // script and other language-specific metadata.
  grammar Json?

  difficulty  Difficulty        @default(EASY)
  status      PublicationStatus @default(DRAFT)
  isPublished Boolean           @default(false)

  notes String? @db.Text

  imageAssetId String?
  audioAssetId String?

  language Language @relation(fields: [languageId], references: [id], onDelete: Restrict)

  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  category VocabularyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  imageAsset MediaAsset? @relation("VocabularyImage", fields: [imageAssetId], references: [id], onDelete: SetNull)

  audioAsset MediaAsset? @relation("VocabularyAudio", fields: [audioAssetId], references: [id], onDelete: SetNull)

  translations   VocabularyTranslation[]
  examples       VocabularyExample[]
  quizQuestions  QuizQuestion[]
  progress       VocabularyProgress[]
  flashcardItems FlashcardDeckItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([languageId, term])
  @@index([languageId, status])
  @@index([lessonId])
  @@index([categoryId])
}

model VocabularyTranslation {
  id String @id @default(cuid())

  vocabularyId String
  languageId   String

  meaning   String  @db.Text
  notes     String? @db.Text
  sortOrder Int     @default(0)

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  language Language @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@index([vocabularyId, languageId, sortOrder])
  @@index([languageId])
}

model VocabularyExample {
  id String @id @default(cuid())

  vocabularyId String
  languageId   String

  text               String  @db.Text
  translationGroupId String?
  sortOrder          Int     @default(0)

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  language Language @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@index([vocabularyId, sortOrder])
  @@index([translationGroupId])
}

// =============================================
// FLASHCARDS
// =============================================

model FlashcardDeck {
  id    String @id @default(cuid())
  appId String

  title       String
  description String? @db.Text

  difficulty  Difficulty @default(EASY)
  isPublished Boolean    @default(false)
  sortOrder   Int        @default(0)

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  items FlashcardDeckItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appId, isPublished])
}

model FlashcardDeckItem {
  id           String @id @default(cuid())
  deckId       String
  vocabularyId String
  sortOrder    Int    @default(0)

  deck FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([deckId, vocabularyId])
  @@index([deckId, sortOrder])
}

// =============================================
// GLOBAL QUIZ ENGINE
// =============================================

model Quiz {
  id String @id @default(cuid())

  appId    String?
  lessonId String?

  title       String
  description String? @db.Text

  difficulty  Difficulty        @default(EASY)
  status      PublicationStatus @default(DRAFT)
  isPublished Boolean           @default(false)

  timeLimitSeconds Int?
  passingScore     Int?

  app App? @relation(fields: [appId], references: [id], onDelete: SetNull)

  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appId, status])
  @@index([lessonId])
}

model QuizQuestion {
  id String @id @default(cuid())

  quizId       String
  vocabularyId String?

  questionType QuestionType @default(MULTIPLE_CHOICE)

  questionText String? @db.Text
  imageUrl     String? @db.Text
  audioUrl     String? @db.Text

  correctAnswer String? @db.Text
  optionsJson   Json?
  explanation   String? @db.Text

  settings Json?

  points    Int @default(1)
  sortOrder Int @default(0)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  vocabulary Vocabulary? @relation(fields: [vocabularyId], references: [id], onDelete: SetNull)

  options QuizOption[]
  answers QuizAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quizId, sortOrder])
  @@index([vocabularyId])
  @@index([questionType])
}

model QuizOption {
  id String @id @default(cuid())

  questionId String

  text      String  @db.Text
  isCorrect Boolean @default(false)
  sortOrder Int     @default(0)

  metadata Json?

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, sortOrder])
}

// =============================================
// USERS & EMAIL VERIFICATION
// =============================================

model User {
  id String @id @default(cuid())

  email        String? @unique @db.VarChar(191)
  displayName  String?
  passwordHash String? @db.Text
  phoneNumber  String? @db.VarChar(20) // E.164, optional; no phone OTP

  role UserRole @default(USER)

  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?

  referralCode String? @unique @db.VarChar(20)
  referredById String?

  adFreeUntil DateTime?

  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime? @db.Date

  lastLoginAt DateTime?

  referrer User? @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)

  referredUsers User[] @relation("UserReferrals")

  sessions       UserSession[]
  passwordResets PasswordResetToken[]
  enrollments    UserLanguageEnrollment[]

  lessonProgress           LessonProgress[]
  vocabularyProgress       VocabularyProgress[]
  quizAttempts             QuizAttempt[]
  subscriptions            Subscription[]
  payments                 PaymentTransaction[]
  activities               UserActivity[]
  promoRedemptions         PromoRedemption[]
  marketingConsents        MarketingConsent[]
  notificationPreferences  NotificationPreference[]
  userNotifications        UserNotification[]
  pushDevices              PushDevice[]
  notificationDeliveries   NotificationDelivery[]
  announcementInteractions AnnouncementInteraction[]
  refundRequests           RefundRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referredById])
  @@index([isActive])
  @@index([phoneNumber])
}

model PendingEmailRegistration {
  id String @id @default(cuid())

  email       String @unique @db.VarChar(191)
  displayName String @db.VarChar(120)

  passwordHash String @db.Text
  otpHash      String @db.VarChar(64)

  // Capture optional phone and marketing choices before email verification.
  phoneNumber            String? @db.VarChar(20)
  marketingEmailOptIn    Boolean @default(false)
  marketingWhatsappOptIn Boolean @default(false)
  marketingSmsOptIn      Boolean @default(false)
  consentPolicyVersion   String? @db.VarChar(40)

  expiresAt         DateTime
  resendAvailableAt DateTime

  attempts Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model UserSession {
  id     String @id @default(cuid())
  userId String

  tokenHash String @unique @db.VarChar(128)

  expiresAt DateTime
  revokedAt DateTime?

  ipAddress String? @db.VarChar(64)
  userAgent String? @db.VarChar(500)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id     String @id @default(cuid())
  userId String

  tokenHash String @unique @db.VarChar(128)

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// =============================================
// LEARNER PROGRESS
// =============================================

model UserLanguageEnrollment {
  id String @id @default(cuid())

  userId     String
  languageId String
  levelId    String?

  isActive Boolean @default(true)

  enrolledAt    DateTime  @default(now())
  lastStudiedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  language Language @relation(fields: [languageId], references: [id], onDelete: Restrict)

  level ProficiencyLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)

  @@unique([userId, languageId])
  @@index([languageId, levelId])
}

model LessonProgress {
  id String @id @default(cuid())

  userId   String
  lessonId String

  completion   Int  @default(0)
  lastPosition Int?

  completedAt  DateTime?
  lastOpenedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model VocabularyProgress {
  id String @id @default(cuid())

  userId       String
  vocabularyId String

  correctCount Int @default(0)
  wrongCount   Int @default(0)

  streak       Int          @default(0)
  masteryScore Int          @default(0)
  masteryLevel MasteryLevel @default(NEW)

  easeFactor      Float @default(2.5)
  intervalDays    Int   @default(0)
  repetitionCount Int   @default(0)

  nextReviewAt   DateTime?
  lastReviewedAt DateTime?
  firstLearnedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, vocabularyId])
  @@index([userId, nextReviewAt])
}

model QuizAttempt {
  id String @id @default(cuid())

  userId String
  quizId String

  score      Int    @default(0)
  total      Int    @default(0)
  percentage Float?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  answers QuizAnswer[]

  @@index([userId, quizId])
  @@index([quizId])
}

model QuizAnswer {
  id String @id @default(cuid())

  attemptId  String
  questionId String

  answer    String  @db.Text
  isCorrect Boolean

  responseTimeMs Int?

  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([attemptId, questionId])
  @@index([questionId])
}

// =============================================
// SUBSCRIPTIONS & PAYMENTS
// =============================================

model Subscription {
  id String @id @default(cuid())

  userId String
  appId  String

  platform SubscriptionPlatform @default(WEB)

  provider  String
  productId String

  externalId            String?
  originalTransactionId String?

  status SubscriptionStatus @default(PENDING)

  startedAt DateTime?
  expiresAt DateTime?
  autoRenew Boolean   @default(false)

  // Cancellation is not the same as immediately revoking paid access.
  cancelAtPeriodEnd  Boolean   @default(false)
  cancelRequestedAt  DateTime?
  cancelledAt        DateTime?
  cancellationReason String?   @db.VarChar(500)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  app App @relation(fields: [appId], references: [id], onDelete: Restrict)

  payments             PaymentTransaction[]
  refundRequests       RefundRequest[]
  cancellationRequests SubscriptionCancellationRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, appId, status])
  @@index([originalTransactionId])
}

model PaymentTransaction {
  id String @id @default(cuid())

  userId         String
  subscriptionId String?

  provider              String
  externalTransactionId String

  status PaymentStatus @default(PENDING)

  amountMinor BigInt
  currency    String @db.VarChar(3)

  verifiedAt DateTime?
  refundedAt DateTime?

  metadata Json?

  refundRequests RefundRequest[]

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, externalTransactionId])
  @@index([userId, status])
}

// =============================================
// ADVERTISEMENT
// =============================================

model AdConfig {
  id    String @id @default(cuid())
  appId String

  provider AdProvider @default(ADMOB)
  platform String

  appAdId String?

  bannerAdUnitId       String?
  interstitialAdUnitId String?
  rewardedAdUnitId     String?
  nativeAdUnitId       String?

  isEnabled Boolean @default(true)
  settings  Json?

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, platform, provider])
}

// =============================================
// ADMIN AUTHENTICATION
// =============================================

model AdminUser {
  id String @id @default(cuid())

  email        String  @unique
  displayName  String?
  passwordHash String  @db.Text

  role AdminRole @default(CONTENT_EDITOR)

  isActive    Boolean @default(true)
  authVersion Int     @default(0)

  lastLoginAt       DateTime?
  passwordChangedAt DateTime?

  refreshTokens   AdminRefreshToken[]
  auditLogs       AdminAuditLog[]
  approvedRefunds RefundRequest[]     @relation("RefundReviewedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, isActive])
}

model AdminRefreshToken {
  id String @id @default(cuid())

  adminId   String
  tokenHash String @unique
  familyId  String

  expiresAt DateTime
  revokedAt DateTime?

  ipAddress String? @db.VarChar(64)
  userAgent String? @db.VarChar(500)

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([adminId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

model AdminAuditLog {
  id String @id @default(cuid())

  adminId String?

  action     String
  entityType String?
  entityId   String?

  ipAddress String? @db.VarChar(64)
  userAgent String? @db.VarChar(500)

  metadata Json?

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
}

// =============================================
// BACKGROUND JOBS & BULK IMPORT
// =============================================

model BackgroundJob {
  id String @id @default(cuid())

  appId String?

  type   JobType
  status JobStatus @default(PENDING)

  entityType String?
  entityId   String?

  payload Json?
  result  Json?

  attempts    Int @default(0)
  maxAttempts Int @default(3)

  errorMessage String? @db.Text

  scheduledAt DateTime  @default(now())
  lockedUntil DateTime?

  startedAt   DateTime?
  completedAt DateTime?

  app App? @relation(fields: [appId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([appId])
  @@index([entityType, entityId])
}

model BulkImportJob {
  id String @id @default(cuid())

  appId    String
  filename String?

  status ImportStatus @default(PENDING)

  totalRows     Int @default(0)
  processedRows Int @default(0)
  successRows   Int @default(0)
  failedRows    Int @default(0)

  errorReport Json?
  metadata    Json?

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appId, status])
}

// =============================================
// GLOBAL SETTINGS
// =============================================

model SystemSetting {
  id String @id @default(cuid())

  key   String @unique
  value String @db.LongText

  description String? @db.Text
  isPublic    Boolean @default(false)

  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================
// PROMOTIONS
// =============================================

model PromoCode {
  id String @id @default(cuid())

  code        String  @unique
  discountPct Int
  description String? @db.Text

  isActive Boolean @default(true)

  validFrom  DateTime?
  validUntil DateTime?

  maxUses     Int?
  currentUses Int  @default(0)

  redemptions   PromoRedemption[]
  announcements AnnouncementPromotion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model PromoRedemption {
  id String @id @default(cuid())

  promoCodeId String
  userId      String

  redeemedAt DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, userId])
  @@index([userId])
}

// =============================================
// USER ACTIVITY & STREAK
// =============================================

model UserActivity {
  id String @id @default(cuid())

  userId String

  date DateTime @db.Date

  durationMinutes Int     @default(0)
  isStreakCounted Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

// =============================================
// WEBSITE ADVERTISEMENT MANAGEMENT
// =============================================

enum WebAdKind {
  LOCAL_IMAGE
  ADSENSE
  GAM
}

enum WebAdStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum WebAdEventKind {
  IMPRESSION
  CLICK
}

model WebAdPlacement {
  id String @id @default(cuid())

  // e.g. "learning-web"
  siteKey String @db.VarChar(80)

  // e.g. "home_top", "lesson_middle"
  key String @db.VarChar(100)

  name   String @db.VarChar(150)
  width  Int?
  height Int?

  isActive Boolean @default(true)

  campaigns WebAdCampaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteKey, key])
  @@index([siteKey, isActive])
}

model WebAdCampaign {
  id          String @id @default(cuid())
  placementId String

  name   String      @db.VarChar(180)
  kind   WebAdKind
  status WebAdStatus @default(DRAFT)

  // LOCAL_IMAGE
  mediaAssetId   String?
  destinationUrl String? @db.Text
  altText        String? @db.VarChar(300)

  // ADSENSE or GAM
  providerClient String? @db.VarChar(150)
  providerSlot   String? @db.VarChar(200)

  // Scheduling and delivery
  startsAt DateTime?
  endsAt   DateTime?

  priority Int @default(0)
  weight   Int @default(1)

  // Null means all languages or all pages
  languageCode String? @db.VarChar(16)
  pagePrefix   String? @db.VarChar(300)

  placement WebAdPlacement @relation(fields: [placementId], references: [id], onDelete: Restrict)

  events WebAdEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placementId, status, priority])
  @@index([startsAt, endsAt])
  @@index([languageCode])
}

model WebAdEvent {
  id         String @id @default(cuid())
  campaignId String

  // Signed delivery token identifier
  tokenId String @db.VarChar(64)

  kind WebAdEventKind

  campaign WebAdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([campaignId, tokenId, kind])
  @@index([campaignId, kind, createdAt])
  @@index([createdAt])
}

// ============================================================
// GLOBAL ANNOUNCEMENTS, NOTIFICATIONS & MARKETING
// Additive schema: uses existing Users, Media, Promotions and Payments.
// All provider channels default disabled until configured.
// Secrets must stay OUT of Prisma rows; use credentialRef to a
// protected secret store or encrypted secret provider.
// ============================================================

enum NotificationChannel {
  WEBSITE_BANNER
  IN_APP
  NOTIFICATION_BELL
  EMAIL
  MOBILE_PUSH
  WEB_PUSH
  WHATSAPP
  SMS
}

enum NotificationPurpose {
  MARKETING
  TRANSACTIONAL
  SYSTEM
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum AnnouncementKind {
  PROMOTION
  COURSE_UPDATE
  SUBSCRIPTION
  MAINTENANCE
  SECURITY
  GENERAL
}

enum NotificationDeliveryStatus {
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  FAILED
  SKIPPED
  CANCELLED
}

enum AnnouncementInteractionKind {
  VIEW
  CLICK
  DISMISS
}

enum SubscriptionCancellationStatus {
  REQUESTED
  PROCESSING
  CONFIRMED
  FAILED
}

enum RefundRequestStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PROCESSING
  REFUNDED
  FAILED
  CANCELLED
}

model ConsentPolicy {
  id          String    @id @default(cuid())
  version     String    @unique @db.VarChar(40)
  title       String    @db.VarChar(180)
  documentUrl String?   @db.Text
  contentHash String?   @db.VarChar(64)
  isActive    Boolean   @default(false)
  effectiveAt DateTime?
  createdAt   DateTime  @default(now())

  consents MarketingConsent[]

  @@index([isActive, effectiveAt])
}

// Append-only consent records. Latest choice by recordedAt governs
// marketing eligibility; no implied consent from email possession.
model MarketingConsent {
  id            String              @id @default(cuid())
  userId        String
  policyId      String?
  channel       NotificationChannel
  purpose       NotificationPurpose @default(MARKETING)
  granted       Boolean             @default(false)
  source        String              @db.VarChar(80)
  policyVersion String              @db.VarChar(40)
  recordedAt    DateTime            @default(now())
  metadata      Json?

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy ConsentPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@index([userId, channel, purpose, recordedAt])
  @@index([channel, purpose, granted])
}

// Explicit user notification preferences are not a replacement
// for marketing consent; both checks are required for marketing.
model NotificationPreference {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel
  purpose   NotificationPurpose
  enabled   Boolean             @default(true)
  updatedAt DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, purpose])
}

// Feature switch, adapter name, template namespace and reference to
// encrypted credentials. Never store tokens/API keys in settingsJson.
model NotificationProviderConfig {
  id            String              @id @default(cuid())
  channel       NotificationChannel
  providerKey   String              @db.VarChar(80)
  displayName   String              @db.VarChar(120)
  isEnabled     Boolean             @default(false)
  isTestMode    Boolean             @default(true)
  credentialRef String?             @db.VarChar(191)
  settingsJson  Json?
  lastCheckedAt DateTime?
  lastCheckOk   Boolean?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  deliveries NotificationDelivery[]
  templates  NotificationTemplate[]

  @@unique([channel, providerKey])
  @@index([channel, isEnabled])
}

model NotificationTemplate {
  id                 String              @id @default(cuid())
  templateKey        String              @unique @db.VarChar(100)
  channel            NotificationChannel
  purpose            NotificationPurpose @default(MARKETING)
  providerConfigId   String?
  providerTemplateId String?             @db.VarChar(191)
  isActive           Boolean             @default(false)
  parametersJson     Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  providerConfig NotificationProviderConfig?       @relation(fields: [providerConfigId], references: [id], onDelete: SetNull)
  translations   NotificationTemplateTranslation[]
  deliveries     NotificationDelivery[]

  @@index([channel, purpose, isActive])
}

model NotificationTemplateTranslation {
  id         String   @id @default(cuid())
  templateId String
  locale     String   @db.VarChar(16)
  title      String?  @db.VarChar(220)
  body       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, locale])
}

// Targeting is configured with a versioned, server-validated rule AST:
// appId, languageId, levelId, platform, subscription, enrollment,
// activity and country only when those fields are genuinely available.
// Never execute arbitrary expressions or SQL from rulesJson.
model AudienceSegment {
  id           String   @id @default(cuid())
  segmentKey   String   @unique @db.VarChar(100)
  name         String   @db.VarChar(160)
  description  String?  @db.Text
  rulesVersion Int      @default(1)
  rulesJson    Json
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  targets AnnouncementTarget[]

  @@index([isActive])
}

model Announcement {
  id            String              @id @default(cuid())
  slug          String              @unique @db.VarChar(160)
  kind          AnnouncementKind    @default(GENERAL)
  purpose       NotificationPurpose @default(MARKETING)
  status        AnnouncementStatus  @default(DRAFT)
  priority      Int                 @default(0)
  isDismissible Boolean             @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  actionType    String?             @db.VarChar(40)
  actionValue   String?             @db.Text
  imageAssetId  String?
  metadata      Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  imageAsset        MediaAsset?               @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)
  translations      AnnouncementTranslation[]
  placements        AnnouncementPlacement[]
  targets           AnnouncementTarget[]
  promotions        AnnouncementPromotion[]
  userNotifications UserNotification[]
  deliveries        NotificationDelivery[]
  interactions      AnnouncementInteraction[]

  @@index([status, startsAt, endsAt])
  @@index([kind, priority])
}

model AnnouncementTranslation {
  id             String   @id @default(cuid())
  announcementId String
  locale         String   @db.VarChar(16)
  title          String   @db.VarChar(220)
  message        String   @db.Text
  actionLabel    String?  @db.VarChar(120)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, locale])
}

model AnnouncementPlacement {
  id               String              @id @default(cuid())
  announcementId   String
  channel          NotificationChannel
  placementKey     String              @db.VarChar(100)
  isEnabled        Boolean             @default(true)
  displayRulesJson Json?

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, channel, placementKey])
  @@index([channel, placementKey, isEnabled])
}

// Multiple include/exclude segments can be attached to an announcement.
model AnnouncementTarget {
  id             String  @id @default(cuid())
  announcementId String
  segmentId      String
  exclude        Boolean @default(false)

  announcement Announcement    @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  segment      AudienceSegment @relation(fields: [segmentId], references: [id], onDelete: Restrict)

  @@unique([announcementId, segmentId])
  @@index([segmentId, exclude])
}

model AnnouncementPromotion {
  id             String @id @default(cuid())
  announcementId String
  promoCodeId    String

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  promoCode    PromoCode    @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)

  @@unique([announcementId, promoCodeId])
  @@index([promoCodeId])
}

model UserNotification {
  id             String    @id @default(cuid())
  userId         String
  announcementId String
  readAt         DateTime?
  dismissedAt    DateTime?
  createdAt      DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([userId, readAt, createdAt])
}

model PushDevice {
  id              String              @id @default(cuid())
  userId          String
  channel         NotificationChannel
  platform        String              @db.VarChar(30)
  tokenHash       String              @unique @db.VarChar(64)
  tokenCiphertext String              @db.Text
  isActive        Boolean             @default(true)
  lastSeenAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel, isActive])
}

// Dedupe key and queue state allow retries and safe provider callbacks.
// Recipient must be resolved by backend from eligible users + consent.
model NotificationDelivery {
  id                String                     @id @default(cuid())
  announcementId    String?
  templateId        String?
  userId            String?
  providerConfigId  String?
  channel           NotificationChannel
  purpose           NotificationPurpose
  status            NotificationDeliveryStatus @default(QUEUED)

  dedupeKey         String  @unique @db.VarChar(191)
  recipientHash     String? @db.VarChar(64)
  providerMessageId String? @db.VarChar(191)

  // ==========================================
  // DELIVERY ATTEMPTS
  // ==========================================

  attempts    Int @default(0)
  maxAttempts Int @default(3)

  // ==========================================
  // RELIABLE WORKER LOCKING
  // ==========================================

  lockOwner    String?   @db.VarChar(100)
  lockedUntil  DateTime?
  claimVersion Int       @default(0)

  // ==========================================
  // DELIVERY SCHEDULING
  // ==========================================

  scheduledAt DateTime @default(now())
  nextRetryAt DateTime?

  // ==========================================
  // DELIVERY TIMESTAMPS
  // ==========================================

  sentAt         DateTime?
  deliveredAt    DateTime?
  acknowledgedAt DateTime?

  // ==========================================
  // ERRORS & PAYLOAD
  // ==========================================

  errorCode    String? @db.VarChar(100)
  errorMessage String? @db.Text
  payloadJson  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==========================================
  // RELATIONS
  // ==========================================

  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)

  template NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  providerConfig NotificationProviderConfig? @relation(fields: [providerConfigId], references: [id], onDelete: SetNull)

  // ==========================================
  // INDEXES
  // ==========================================

  @@index([status, scheduledAt, nextRetryAt])
  @@index([status, lockedUntil])
  @@index([userId, createdAt])
  @@index([providerMessageId])
  @@index([announcementId, channel])
}

model AnnouncementInteraction {
  id             String                      @id @default(cuid())
  announcementId String
  userId         String?
  kind           AnnouncementInteractionKind
  dedupeKey      String?                     @unique @db.VarChar(191)
  contextJson    Json?
  createdAt      DateTime                    @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([announcementId, kind, createdAt])
  @@index([userId, createdAt])
}

// Provider-confirmed cancellation is distinct from cancelling locally.
model SubscriptionCancellationRequest {
  id                String                         @id @default(cuid())
  subscriptionId    String
  status            SubscriptionCancellationStatus @default(REQUESTED)
  initiatedBy       String                         @default("USER") @db.VarChar(30)
  reason            String?                        @db.VarChar(500)
  idempotencyKey    String                         @unique @db.VarChar(191)
  providerReference String?                        @db.VarChar(191)
  requestedAt       DateTime                       @default(now())
  confirmedAt       DateTime?
  errorCode         String?                        @db.VarChar(100)
  updatedAt         DateTime                       @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, status, requestedAt])
}

// App Store / Google Play / web processor refunds are distinct flows.
// Status must be changed only after the correct provider confirms it.
model RefundRequest {
  id                String              @id @default(cuid())
  userId            String
  paymentId         String
  subscriptionId    String?
  status            RefundRequestStatus @default(REQUESTED)
  reason            String              @db.Text
  adminNote         String?             @db.Text
  amountMinor       BigInt
  currency          String              @db.VarChar(3)
  providerRefundId  String?             @db.VarChar(191)
  reviewedByAdminId String?
  requestedAt       DateTime            @default(now())
  reviewedAt        DateTime?
  resolvedAt        DateTime?
  updatedAt         DateTime            @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment      PaymentTransaction @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  subscription Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  reviewedBy   AdminUser?         @relation("RefundReviewedBy", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@index([userId, status, requestedAt])
  @@index([paymentId, status])
  @@index([subscriptionId])
  @@index([providerRefundId])
}
